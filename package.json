{
  "name": "fancanon-web",
  "private": true,
  "version": "0.9.0@next",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler run typegen && wrangler types --check && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "clean": "rimraf .svelte-kit .wrangler",
    "typegen": "wrangler types",
    "db:start": "docker compose up --detach",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth/index.ts --output src/lib/server/db/schema/auth.schema.ts --yes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@humanspeak/svelte-markdown": "^1.8.7",
    "@inlang/paraglide-js": "^2.24.1",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.33.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prgm/sveltekit-progress-bar": "^3.0.2",
    "@qwik.dev/partytown": "^0.14.0",
    "@sentry/sveltekit": "^10.70.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/svelte-query": "^6.1.38",
    "@tanstack/svelte-query-devtools": "^6.1.38",
    "@tanstack/svelte-table": "^9.1.2",
    "@types/node": "^26.2.0",
    "@types/slug": "^5.0.9",
    "@upstash/redis": "^1.38.2",
    "auth": "^1.7.1",
    "better-auth": "^1.7.1",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.6.0",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.12.7",
    "mode-watcher": "^1.1.0",
    "numify": "^1.1.2",
    "postgres": "^3.4.9",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prosekit": "^0.22.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "remark-supersub": "^1.0.0",
    "resend": "^6.21.0",
    "rimraf": "^6.1.3",
    "runed": "^0.37.1",
    "shadcn-svelte": "^1.5.0",
    "slug": "^12.0.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "ts-md5": "^2.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "unified": "^11.0.5",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
